<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout style="@style/Card">

            <TextView style="@style/SectionTitle" android:text="Book name" />

            <TextView
                style="@style/Label"
                android:layout_marginTop="4dp"
                android:text="Shown at the top of the app and on every report." />

            <EditText
                android:id="@+id/bookNameEdit"
                style="@style/Input"
                android:inputType="textCapWords"
                android:maxLength="30" />

            <Button
                android:id="@+id/saveBookName"
                style="@style/OutlineButton"
                android:layout_marginTop="10dp"
                android:text="Save name" />
        </LinearLayout>

        <LinearLayout style="@style/Card" android:layout_marginTop="12dp">

            <TextView style="@style/SectionTitle" android:text="Security" />

            <Switch
                android:id="@+id/bioSwitch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:text="Unlock with fingerprint"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/changePassword"
                style="@style/OutlineButton"
                android:layout_marginTop="6dp"
                android:text="Change password" />

            <Button
                android:id="@+id/lockNow"
                style="@style/OutlineButton"
                android:layout_marginTop="10dp"
                android:text="Lock now" />
        </LinearLayout>

        <LinearLayout style="@style/Card" android:layout_marginTop="12dp">

            <TextView style="@style/SectionTitle" android:text="Google Drive backup" />

            <TextView
                android:id="@+id/backupInfo"
                style="@style/Label"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/backupNow"
                style="@style/PrimaryButton"
                android:layout_marginTop="12dp"
                android:text="Back up to Google Drive now" />

            <Button
                android:id="@+id/restoreBackup"
                style="@style/OutlineButton"
                android:layout_marginTop="10dp"
                android:text="Restore from a backup file" />
        </LinearLayout>

        <LinearLayout style="@style/Card" android:layout_marginTop="12dp">

            <TextView style="@style/SectionTitle" android:text="Upload transactions" />

            <TextView
                style="@style/Label"
                android:layout_marginTop="4dp"
                android:text="Upload a CSV file with the columns Date, Person, Debit, Credit, Particular, Description. Every row is checked, and rows that are already in the book are skipped." />

            <Button
                android:id="@+id/uploadCsv"
                style="@style/PrimaryButton"
                android:layout_marginTop="12dp"
                android:text="Upload a CSV file" />

            <Button
                android:id="@+id/sampleCsv"
                style="@style/OutlineButton"
                android:layout_marginTop="10dp"
                android:text="Get a sample file" />
        </LinearLayout>

        <TextView
            android:id="@+id/aboutText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/dim"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
